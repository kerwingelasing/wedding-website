{
  "name": "wedding-website",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --project demo-wedding --only auth,firestore",
    "seed": "node scripts/seed.mjs",
    "test:rules": "firebase emulators:exec --project demo-wedding --only firestore \"vitest run\"",
    "deploy": "npm run test:rules && npm run build && firebase deploy"
  },
  "description": "Wedding website with RSVP and admin dashboard (Firebase)",
  "dependencies": {
    "firebase": "^13.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.33.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "private": true,
  "type": "module"
}
